# Infinity Social Media Platform - Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to version control

# ============================================
# APPLICATION (NODE_ENV is set automatically by Next.js)
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# ============================================
# SUPABASE (Database + Auth + Realtime)
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# ============================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL is the PostgreSQL connection string for direct DB access
# Get from: https://supabase.com/dashboard/project/_/settings/database
DATABASE_URL=

# ============================================
# CLOUDFLARE R2 (Object Storage for Media)
# Get these from: https://dash.cloudflare.com/ -> R2 -> Manage Account
# ============================================
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=infinity-media
R2_PUBLIC_BASE_URL=
R2_ENDPOINT=

# ============================================
# GOOGLE OAUTH (Optional - for social login)
# Get from: https://console.cloud.google.com/apis/credentials
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================
# EMAIL (Optional - Supabase Auth handles email by default)
# Only needed if using custom SMTP
# ============================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ============================================
# FEATURE FLAGS
# ============================================
NEXT_PUBLIC_ENABLE_REALTIME=true
NEXT_PUBLIC_ENABLE_STORIES=true
NEXT_PUBLIC_ENABLE_POLLS=true
NEXT_PUBLIC_ENABLE_MESSAGING=true
NEXT_PUBLIC_ENABLE_MARKETPLACE=true

# ImgBB Free API (https://api.imgbb.com/) for automatic image-to-link hosting
IMGBB_API_KEY=
